{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://skillsprint-production-ded3.up.railway.app/api/:path*" },
    { "source": "/documents/:id/download", "destination": "https://skillsprint-production-ded3.up.railway.app/documents/:id/download" },
    { "source": "/plans/:id/json", "destination": "https://skillsprint-production-ded3.up.railway.app/plans/:id/json" },
    { "source": "/plans/:id/validation.csv", "destination": "https://skillsprint-production-ded3.up.railway.app/plans/:id/validation.csv" },
    { "source": "/experiments/:id/json", "destination": "https://skillsprint-production-ded3.up.railway.app/experiments/:id/json" },
    { "source": "/reports.csv", "destination": "https://skillsprint-production-ded3.up.railway.app/reports.csv" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
    ] }
  ]
}
