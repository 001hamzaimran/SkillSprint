# SkillSprint local configuration; see documentation/DEPLOYMENT.md for hosting.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_SECRET_KEY=REPLACE_WITH_RANDOM_48_BYTE_SECRET
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillsprint
POSTGRES_SCHEMA=skillsprint
GENAI_PROVIDER=openai
OPENAI_API_KEY=
GENAI_MODEL=gpt-4.1-mini
SESSION_COOKIE_SECURE=false
PORT=8000
BOOTSTRAP_ADMIN_EMAIL=admin@skillsprint.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
RUN_WORKER=true
# Required for production password-reset email delivery. Local development shows
# the one-time reset link on the confirmation page when SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
# SECRET_KEY is a legacy alias for APP_SECRET_KEY. MongoDB is no longer used.
# Never expose DATABASE_URL, APP_SECRET_KEY, SMTP_PASSWORD or OPENAI_API_KEY in Vite.
